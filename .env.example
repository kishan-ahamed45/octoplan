# ==========================================
# OctoPlan — Self-Hosted Configuration
# ==========================================

# Security: Change this to a long random string in production
AUTH_SECRET=change-this-to-a-long-random-secret
# Set to "true" only when serving OctoPlan over HTTPS
COOKIE_SECURE=false

# ==========================================
# Database (Neon / PostgreSQL via Drizzle ORM)
# Leave empty to run with zero-config local JSON storage (.local-db.json)
# ==========================================
DATABASE_URL=

# ==========================================
# AI Providers (Pick any — or leave blank for offline fallback)
# ==========================================

# Option 1: Local AI via Ollama (100% private, no external API calls)
# Example: http://localhost:11434 (or http://ollama:11434 in Docker Compose)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Option 2: Google Gemini API
GEMINI_API_KEY=

# Option 3: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
