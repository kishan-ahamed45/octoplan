# AI Provider Configuration
# Option 1: OpenRouter (Free models like google/gemini-2.0-flash-exp:free, meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Option 2: Google Gemini Direct API Key
GEMINI_API_KEY=

# Supabase Configuration (Optional: In-memory/file storage runs if omitted)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
